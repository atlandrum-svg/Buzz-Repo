	_queue_row = HBoxContainer.new()
	_queue_row.add_theme_constant_override("separation", 4)
	_queue_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vb.add_child(_queue_row)


func _build_card_overlay() -> void:
	var card := PanelContainer.new()
	card.add_theme_stylebox_override("panel",
		_panel_style(Color(0.04, 0.02, 0.05, 0.88), C_RED, 2, 3, 6))
	card.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.position = Vector2(10.0, _px(BOARD_H) - 100.0)
	_stage.add_child(card)

	var row := HBoxContainer.new()
