# ------------------------------------------------------------ public API -----
func show_and_play(traits: Array, anxiety: int) -> Dictionary:
	if not _built:
		_load_art()
		_build_ui()

	_anxiety = clampi(anxiety, 0, 100)
	_diff = clampf(float(_anxiety) / 100.0, 0.0, 1.0)
	_tier = clampi(int(_anxiety / 25), 0, WOBBLE_TIER_DEG.size() - 1)
	_obscured.clear()
	_exposed.clear()
	_shots.clear()
	_socket_count = 0
	_socket_pos = Vector2(SOCKET_HOME_X, SOCKET_HOME_Y)
	_index = 0
	_abort_requested = false
	_summary.visible = false
	_call_label.text = ""
	_power_label.text = ""
	_flash.color = Color(1, 1, 1, 0)
	_clear_floor_icons()

	_traits = _prepare_ammo(traits)

	if _traits.is_empty():
		return await _play_empty()

	visible = true
	_running = true
	get_tree().paused = true
	_input_gate_frame = Engine.get_process_frames() + INPUT_GATE_FRAMES

	_anx_label.text = "ANXIETY %d   (WOBBLE %d/4)" % [_anxiety, _tier]
	_anx_label.add_theme_color_override("font_color", _anxiety_color())
	_set_socket_lit(false)
	_refresh_socket_count()
	if _socket_rect:
		_place(_socket_rect, _socket_pos.x, _socket_pos.y)
	_refresh_queue()

	_hint_label.text = "W / S  AIM     HOLD SPACE  CHARGE     RELEASE  THROW"
	_call_label.text = "HIDE WHAT YOU CAN"
	await _wait(1.1)
	_call_label.text = ""

	# The socket has no capacity limit: land every trait and nothing shows.
	while _index < _traits.size():
		if _abort_requested:
			break
		await _play_one_trait()
		if _abort_requested:
			break
		_index += 1

	# Anything never thrown (aborted) is exposed by default.
	while _index < _traits.size():
		_exposed.append(String(_traits[_index].get("id", "")))
		_index += 1

	_projectile.visible = false
	_set_arrow_visible(false)
	_clear_dots()
	await _show_summary()

	_running = false
	visible = false
	get_tree().paused = false

	var result := {
		"outcome": "cancel" if _abort_requested else "done",
		"obscured": _obscured.duplicate(),
		"exposed": _exposed.duplicate(),
		"shots": _shots.duplicate(),
		"anxiety": _anxiety,
	}
	minigame_finished.emit(result)
	return result


func hide_popup() -> void:
	_running = false
	visible = false
	if get_tree():
		get_tree().paused = false


# ------------------------------------------------------------- ammo setup ----
func _prepare_ammo(traits: Array) -> Array:
	var out: Array = []
	for t in traits:
		if typeof(t) != TYPE_DICTIONARY:
			continue
		var id: String = String(t.get("id", ""))
		if id.is_empty():
			continue
		if int(t.get("amount", 0)) <= 0:
			continue
		out.append({
			"id": id,
			"label": String(t.get("label", id)),
			"amount": int(t.get("amount", 0)),
			"tex": String(t.get("tex", "")),
			"tip": String(t.get("tip", "")),
			"locked": bool(t.get("locked", false)),
		})
	if AMMO_ORDER_WORST_FIRST:
		out.sort_custom(func(a, b): return int(a["amount"]) > int(b["amount"]))
	else:
		out.sort_custom(func(a, b): return int(a["amount"]) < int(b["amount"]))
	return out


func _anxiety_color() -> Color:
	if _anxiety >= 75:
		return C_RED
	if _anxiety >= 45:
		return C_ORANGE
	return C_GREEN


func _play_empty() -> Dictionary:
	visible = true
	_call_label.text = "NOTHING TO HIDE"
	_hint_label.text = "You arrive clean. Enjoy it."
	await _wait(1.8)
	visible = false
	var result := {
		"outcome": "empty", "obscured": [], "exposed": [],
		"shots": [], "anxiety": _anxiety,
	}
	minigame_finished.emit(result)
	return result


# --------------------------------------------------------------- per shot ----
func _play_one_trait() -> void:
	var t: Dictionary = _traits[_index]
	var tex: Texture2D = _load_tex(String(t.get("tex", "")))

	if _card_icon:
		_card_icon.texture = tex
	_card_name.text = String(t.get("label", ""))
	_card_amount.text = "%+d ANXIETY" % int(t.get("amount", 0))
	var proj_icon: TextureRect = _projectile.get_node_or_null("Icon") as TextureRect
	if proj_icon:
		proj_icon.texture = tex
	_projectile.rotation = 0.0
	_projectile.visible = false
	_refresh_queue()

	# New position every throw — no grooving one shot and repeating it.
	_relocate_socket()
	_set_socket_lit(false)

	_angle = ANGLE_START
	_charge = 0.0
	_charge_dir = 1.0
	_wobble_t = randf() * 12.0
	_phase = Phase.AIM
	_power_label.text = "PWR   0%"
	_hint_label.text = "W / S  AIM     HOLD SPACE  CHARGE"

	await _aim_phase()
	if _abort_requested:
		return

	var power: float = await _charge_phase()
	if _abort_requested:
		return

	# The shot leaves at the wobbled angle you were actually sitting on when
	# you let go — not the one you were aiming for.
	var fired_angle: float = _effective_angle()
	var serr := _scaled(RELEASE_SPEED_ERR)
	var speed: float = _speed_for(power) * (1.0 + randf_range(-serr, serr))

	_set_arrow_visible(false)
	_clear_dots()
	_hint_label.text = ""
	_power_label.text = "PWR  %d%%" % int(round(power * 100.0))

	var landing: Dictionary = await _flight_phase(fired_angle, speed)
	await _resolve_landing(t, landing, fired_angle, power)


## Free aim. The wobble runs the whole time and is fully visible on the arrow.
func _aim_phase() -> void:
	var aim_speed := _scaled(AIM_SPEED)
	while _running and not _abort_requested:
		var dt: float = await _tick()
		if _gate_open() and _fire_down():
			_phase = Phase.CHARGE
			return
		var dir := 0.0
		if _up_down():
			dir += 1.0
		if _down_down():
			dir -= 1.0
		_angle = clampf(_angle + dir * aim_speed * dt, ANGLE_MIN, ANGLE_MAX)
		_draw_aim(0.0, false)


## Hold to fill. The meter ping-pongs, so overshooting costs you, and the aim
## keeps wobbling underneath it — two things to read at once, on purpose.
func _charge_phase() -> float:
	var rate := _scaled(CHARGE_RATE)
	_hint_label.text = "RELEASE TO THROW"
	while _running and not _abort_requested:
		var dt: float = await _tick()
		if not _fire_down():
			return clampf(_charge, 0.03, 1.0)
		_charge += _charge_dir * rate * dt
		if _charge >= 1.0:
			_charge = 1.0
			_charge_dir = -1.0
		elif _charge <= 0.0:
			_charge = 0.0
			_charge_dir = 1.0
		_power_label.text = "PWR  %d%%" % int(round(_charge * 100.0))
		_draw_aim(_charge)
	return clampf(_charge, 0.03, 1.0)


func _speed_for(power: float) -> float:
	return lerpf(SPEED_MIN, SPEED_MAX, clampf(power, 0.0, 1.0))


## Aim plus the anxiety wobble. Two out-of-phase sines so it reads as a nervous
## hand rather than a metronome.
func _effective_angle() -> float:
	var amp: float = float(WOBBLE_TIER_DEG[_tier])
	if amp <= 0.001:
		return _angle
	var hz: float = float(WOBBLE_TIER_HZ[_tier])
	var w: float = sin(_wobble_t * TAU * hz) * 0.68 \
		+ sin(_wobble_t * TAU * hz * 2.37 + 1.1) * 0.32
	return clampf(_angle + w * amp, ANGLE_MIN - 8.0, ANGLE_MAX + 8.0)


# --------------------------------------------------------------- physics -----
## Integrate the lob. Holders capture on the way down through their mouth;
## anything else bounces off the woodwork and ends up on the floor.
func _flight_phase(angle_deg: float, speed: float) -> Dictionary:
	_phase = Phase.FLIGHT
	_projectile.visible = true
	var rad := deg_to_rad(angle_deg)
	var pos := Vector2(LAUNCH_X, LAUNCH_Y)
	var vel := Vector2(cos(rad) * speed, -sin(rad) * speed)
	var elapsed := 0.0
	var bounces := 0
	var spin := 0.0
	## Cleared by the first contact with anything. Only a clean pass can stick.
	var clean := true

	while _running and elapsed < FLIGHT_MAX_SEC:
		var dt: float = await _tick()
		elapsed += dt
		var remaining := dt
		while remaining > 0.0:
			var step: float = minf(FLIGHT_STEP, remaining)
			remaining -= step
			var prev := pos
			vel.y += GRAVITY * step
			pos += vel * step

			# --- ceiling: solid, and it kills most of the climb -------------
			if pos.y <= CEILING_Y:
				pos.y = CEILING_Y + 0.5
				vel.y = absf(vel.y) * BOUNCE_CEILING
				vel.x *= 0.85
				bounces += 1
				clean = false

			# --- the socket: stick it, do not carom into it -----------------
			# `clean` goes false on any contact, so a shot that has already
			# bounced cannot score. Without that the right-hand wall sits one
			# icon away from the socket and rebounds everything into it.
			if clean and _capture_hit(pos):
				return {"kind": "socket", "pos": _socket_centre()}

			# --- right wall --------------------------------------------------
			if pos.x > float(BOARD_W) - 3.0:
				pos.x = float(BOARD_W) - 3.0
				vel.x = -absf(vel.x) * BOUNCE_WALL
				bounces += 1
				clean = false

			# --- floor --------------------------------------------------------
			if pos.y >= FLOOR_Y:
				pos.y = FLOOR_Y
				if absf(vel.y) < SETTLE_SPEED and absf(vel.x) < SETTLE_SPEED:
					return {"kind": "floor", "holder": -1, "pos": pos,
						"bounces": bounces}
				vel.y = -absf(vel.y) * BOUNCE_FLOOR
				vel.x *= FRICTION
				bounces += 1
				clean = false

		spin += vel.x * 0.014
		_projectile.rotation = spin * 0.06
		_set_projectile_pos(pos)

	return {"kind": "floor", "holder": -1,
		"pos": Vector2(clampf(pos.x, 6.0, float(BOARD_W) - 6.0), FLOOR_Y),
		"bounces": bounces}


func _resolve_landing(t: Dictionary, landing: Dictionary, fired_angle: float,
		power: float) -> void:
	_phase = Phase.SETTLE
	var id: String = String(t.get("id", ""))
	var kind: String = String(landing.get("kind", "floor"))
	var at: Vector2 = landing.get("pos", Vector2(LAUNCH_X, FLOOR_Y))
	var tex: Texture2D = _load_tex(String(t.get("tex", "")))
	var amount: int = int(t.get("amount", 0))
	var locked: bool = bool(t.get("locked", false))

	if kind == "socket":
		_socket_count += 1
		_obscured.append(id)
		# Snap it dead centre — "mostly fits" on the way in, fills the square
		# perfectly once it is home.
		_set_projectile_pos(at)
		_projectile.rotation = 0.0
		_set_socket_lit(true)
		_refresh_socket_count()
		# Left visible in the recess for the beat, then gone — it is hidden now,
		# and the socket is about to move somewhere else anyway.
		_projectile.visible = true
		_puff_at(at)
		_call_out("OBSCURED", C_GREEN)
		_flash_stage(Color(0.42, 0.85, 0.55, 0.26))
	else:
		_exposed.append(id)
		_projectile.rotation = 0.0
		_projectile.visible = false
		_park_icon(tex, amount, locked,
			Vector2(at.x, FLOOR_Y - float(SLOT_PX) / (SCALE * 2.0)), false)
		_puff_at(at)
		_call_out("ON THE FLOOR", C_RED)
		_flash_stage(Color(0.90, 0.35, 0.30, 0.22))

	_shots.append({
		"id": id,
		"result": "obscured" if kind == "socket" else "exposed",
		"angle": snappedf(fired_angle, 0.1),
		"power": snappedf(power, 0.01),
	})
	_refresh_queue()
	await _wait(0.9)
	_call_label.text = ""
	if kind == "socket":
		_projectile.visible = false
		_set_socket_lit(false)


## Leave a copy of the icon where it ended up, so the board tells the story.
## Same square as the anxiety bar, so the floor reads as a spilled version of
## the bar you have been staring at for two levels.
func _park_icon(tex: Texture2D, amount: int, locked: bool, board_pos: Vector2,
		in_socket: bool) -> void:
	if tex == null:
		return
	var sq := _make_icon_square(tex, amount, locked, C_GOLD if in_socket else null)
	sq.position = Vector2(_px(board_pos.x) - SLOT_PX * 0.5,
		_px(board_pos.y) - SLOT_PX * 0.5)
	if in_socket:
		# Earlier traits shrink back into the recess so the newest reads clearly.
		for old_sq in _floor_icons:
			if is_instance_valid(old_sq) and old_sq.get_meta("in_socket", false):
				old_sq.modulate = Color(1, 1, 1, 0.30)
	sq.set_meta("in_socket", in_socket)
	_stage.add_child(sq)
	_stage.move_child(sq, mini(2, _stage.get_child_count() - 1))
	_floor_icons.append(sq)


func _clear_floor_icons() -> void:
	for r in _floor_icons:
		if is_instance_valid(r):
			r.queue_free()
	_floor_icons.clear()


# ------------------------------------------------------------- presentation --
func _set_projectile_pos(board_pos: Vector2) -> void:
	_projectile.position = Vector2(
		_px(board_pos.x) - float(SLOT_PX) * 0.5,
		_px(board_pos.y) - float(SLOT_PX) * 0.5)


func _set_socket_lit(lit: bool) -> void:
	if _socket_rect == null:
		return
	_socket_rect.texture = _atlas(_tex_socket, 1 if lit else 0,
		SOCKET_CELL_W, SOCKET_CELL_H)


func _refresh_socket_count() -> void:
	if _socket_count_label == null:
		return
	_socket_count_label.text = "HIDDEN %d" % _socket_count if _socket_count > 0 else ""


func _call_out(text: String, color: Color) -> void:
	_call_label.text = text
	_call_label.add_theme_color_override("font_color", color)


func _flash_stage(color: Color) -> void:
	if _flash == null:
		return
	_flash.color = color
	var tw := create_tween()
	tw.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.tween_property(_flash, "color", Color(color.r, color.g, color.b, 0.0), 0.35)


func _puff_at(board_pos: Vector2) -> void:
	if _puff_rect == null:
		return
	_puff_rect.visible = true
	_puff_rect.position = Vector2(
		_px(board_pos.x) - _px(PUFF_CELL) * 0.5,
		_px(board_pos.y) - _px(PUFF_CELL) * 0.5)
	_animate_puff()


## Fire-and-forget so shot resolution is not held up by four frames of dust.
func _animate_puff() -> void:
	for i in range(4):
		if not is_instance_valid(_puff_rect):
			return
		_puff_rect.texture = _atlas(_tex_puff, i, PUFF_CELL, PUFF_CELL)
		await _wait(0.07)
	if is_instance_valid(_puff_rect):
		_puff_rect.visible = false


func _refresh_queue() -> void:
	if _queue_row == null:
		return
	for c in _queue_row.get_children():
		c.queue_free()
	var thrown: int = _obscured.size() + _exposed.size()
	_shots_label.text = "%d / %d" % [thrown, _traits.size()]
	for i in range(_traits.size()):
		var t: Dictionary = _traits[i]
		var border := C_GREY
		if i < thrown:
			border = C_GREEN if _obscured.has(String(t.get("id", ""))) else C_RED
		elif i == _index:
			border = C_GOLD
		var slot := _make_icon_square(_load_tex(String(t.get("tex", ""))),
			int(t.get("amount", 0)), bool(t.get("locked", false)), border)
		slot.modulate = Color(1, 1, 1, 0.45) if i < thrown else Color(1, 1, 1, 1)
		slot.tooltip_text = "%s  %+d" % [String(t.get("label", "")),
			int(t.get("amount", 0))]
		_queue_row.add_child(slot)


# ------------------------------------------------------- aim visualisation ---
func _set_arrow_visible(v: bool) -> void:
	if _arrow_edge:
		_arrow_edge.visible = v
	if _arrow_fill:
		_arrow_fill.visible = v


## The strength arrow: it grows out of the thrower as the meter climbs, and it
## rides the anxiety wobble, so what you see is what will actually leave his
## hand. Drawn as polygons rather than a sprite so the length is continuous.
func _draw_arrow(angle_deg: float, power: float) -> void:
	var rad := deg_to_rad(angle_deg)
	var dir := Vector2(cos(rad), -sin(rad))
	var nrm := Vector2(-dir.y, dir.x)
	var origin := _pxv(Vector2(LAUNCH_X, LAUNCH_Y))
	var body_len := _px(lerpf(ARROW_MIN_LEN, ARROW_MAX_LEN, clampf(power, 0.0, 1.0)))
	var hw := _px(ARROW_SHAFT_HW)
	var head_len := _px(ARROW_HEAD_LEN)
	var head_hw := _px(ARROW_HEAD_HW)
	var tip := origin + dir * (body_len + head_len)
	var neck := origin + dir * body_len

	var pts := PackedVector2Array([
		origin + nrm * hw,
		neck + nrm * hw,
		neck + nrm * head_hw,
		tip,
		neck - nrm * head_hw,
		neck - nrm * hw,
		origin - nrm * hw,
	])
	_arrow_fill.polygon = pts
	_arrow_fill.color = C_GOLD.lerp(C_RED, clampf(power, 0.0, 1.0))

	# Fatten the same shape by 2px for a chunky dark outline.
	var edge := PackedVector2Array()
	var centre := origin + dir * (body_len * 0.5)
	for p in pts:
		edge.append(p + (p - centre).normalized() * 2.0)
	_arrow_edge.polygon = edge
	_set_arrow_visible(true)


## Arrow always; the opening fifth of the arc only once you are charging, when
## there is a real power to trace. Never the whole solution, at any point.
func _draw_aim(power: float, with_trace: bool = true) -> void:
	var ang := _effective_angle()
	_draw_arrow(ang, power)
	if with_trace:
		_draw_trace(ang, _speed_for(power))
	else:
		_clear_dots()


func _clear_dots() -> void:
	for d in _dots:
		(d as TextureRect).visible = false


func _draw_trace(angle_deg: float, speed: float) -> void:
	_clear_dots()
	var rad := deg_to_rad(angle_deg)
	var pos := Vector2(LAUNCH_X, LAUNCH_Y)
	var vel := Vector2(cos(rad) * speed, -sin(rad) * speed)
	var step := 0.012
	# First pass: how long is the whole flight? Only a fraction gets drawn.
	var total := 0
	var p2 := pos
	var v2 := vel
	for _i in range(1200):
		v2.y += GRAVITY * step
		p2 += v2 * step
		total += 1
		if p2.y >= FLOOR_Y or p2.x > float(BOARD_W):
			break
	var show: int = maxi(2, int(total * TRACE_FRACTION))
	var every: int = maxi(1, int(show / float(TRACE_DOTS)))
	var drawn := 0
	for i in range(show):
		vel.y += GRAVITY * step
		pos += vel * step
		if i % every != 0:
			continue
		if drawn >= _dots.size():
			break
		var d: TextureRect = _dots[drawn]
		d.texture = _atlas(_tex_dot, 0 if drawn < 3 else 1, DOT_CELL, DOT_CELL)
		d.position = Vector2(_px(pos.x) - _px(DOT_CELL) * 0.5,
			_px(pos.y) - _px(DOT_CELL) * 0.5)
		d.visible = true
		drawn += 1


# ----------------------------------------------------------------- summary ---
func _show_summary() -> void:
	for c in _summary_rows.get_children():
		c.queue_free()

	var head := Label.new()
	head.text = "WHAT SHE CAN SEE"
	_style_label(head, 14, C_GOLD)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_summary_rows.add_child(head)

	_summary_rows.add_child(_summary_group("HIDDEN", _obscured, C_GREEN))
	_summary_rows.add_child(_summary_group("ON THE FLOOR", _exposed, C_RED))

	var foot := Label.new()
	foot.text = "Round 2 draws from what is on the floor."
	_style_label(foot, 8, C_GREY_LT)
	foot.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_summary_rows.add_child(foot)

	_summary.visible = true
	await _wait(2.6)
	_summary.visible = false


func _summary_group(title: String, ids: Array, color: Color) -> Control:
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 4)
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var lab := Label.new()
	lab.text = "%s  (%d)" % [title, ids.size()]
	_style_label(lab, 9, color)
	box.add_child(lab)

	if ids.is_empty():
		var none := Label.new()
		none.text = "—"
		_style_label(none, 8, C_GREY)
		box.add_child(none)
		return box

	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 4)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(row)
	for id in ids:
		var t: Dictionary = _trait_by_id(String(id))
		var slot := _make_icon_square(_load_tex(String(t.get("tex", ""))),
			int(t.get("amount", 1)), false, color)
		slot.tooltip_text = String(t.get("label", id))
		row.add_child(slot)
	return box


func _trait_by_id(id: String) -> Dictionary:
	for t in _traits:
		if String(t.get("id", "")) == id:
			return t
	return {"label": id, "tex": ""}


# ------------------------------------------------------------------ input ----
func _fire_down() -> bool:
	if Input.is_key_pressed(KEY_SPACE):
		return true
	if InputMap.has_action("interact") and Input.is_action_pressed("interact"):
		return true
	return Input.is_key_pressed(KEY_E)


func _up_down() -> bool:
	return Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP)


func _down_down() -> bool:
	return Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN)


func _gate_open() -> bool:
	return Engine.get_process_frames() >= _input_gate_frame


func _input(event: InputEvent) -> void:
	if not visible or not _running:
		return
	if event is InputEventKey and event.pressed and not event.echo:
		if (event as InputEventKey).keycode == KEY_ESCAPE:
			_abort_requested = true
			get_viewport().set_input_as_handled()


# ------------------------------------------------------------------- ticks ---
func _tick() -> float:
	await get_tree().process_frame
	var dt: float = get_process_delta_time()
	_wobble_t += dt
	return minf(dt, 1.0 / 20.0)   # clamp so a hitch cannot teleport the lob


func _wait(sec: float) -> void:
	await get_tree().create_timer(sec, true, false, true).timeout
