extends Control
## TRAIT LOB — Level 3 (The Date), minigame round 1: HIDE IT.
##
## Every negative trait you accumulated in the apartment and the office becomes
## a piece of ammunition. You get exactly one shot with each. Stick it into the
## socket set into the far top-right corner and that trait is OBSCURED — the
## date never finds out. Miss and it drops to the floor, where it lies in plain
## sight for the rest of the evening.
##
## The throw is a Worms grenade — pick the angle, hold to charge, release — but
## the target is a small square socket flush in the corner, so the shot that
## solves it is flat and fast. You are sticking an arrow into a mark, not
## lobbing something into a bucket. There is no full trajectory solution on
## screen: an arrow for power, the first fifth of the arc, and your judgement.
##
## The socket takes as many traits as you can land in it — hit it every time
## and you walk in with nothing showing.
##
## Anxiety is inherited from the previous levels and is the entire difficulty
## curve. It applies a vertical wobble to your aim in four steps, one per 25
## points, and it winds the charge meter up faster than you can read it.
##
## Public API:
##   show_and_play(traits: Array, anxiety: int) -> Dictionary
##     traits: entries shaped exactly like AnxietySystem.listing():
##             {id, label, amount, tex, tip, locked}
##     returns { outcome, obscured, exposed, shots, anxiety }
##       outcome  : "done" | "cancel" | "empty"
##       obscured : [trait_id, …]  stuck in the socket
##       exposed  : [trait_id, …]  on the floor, eligible for the reveal
##       shots    : [{id, result, angle, power}, …] per-shot log
##
## Round 2 (the reveal — RNG picks from `exposed`) is deliberately NOT here.
## This script's only job is producing a clean obscured/exposed split.
##
## Art: trait_lob_minigame/*.png, regenerated by _src_magenta/gen_art.py.
## The board geometry constants below MUST match that script exactly.

signal minigame_finished(result: Dictionary)

# ------------------------------------------------------------------ art ------
const ART_DIR := "res://trait_lob_minigame/"
const BACKDROP_PNG := ART_DIR + "tl_backdrop.png"
const SOCKET_PNG := ART_DIR + "tl_socket.png"
const DOT_PNG := ART_DIR + "tl_dot.png"
const PUFF_PNG := ART_DIR + "tl_puff.png"

## The thrower is the real Player 2 sprite, not a bespoke one — 4x4 sheet,
## frame 8 is the right-facing idle (see the direction table in player_body.gd).
const PLAYER_SHEET := "res://julian assange sprite sheet black.png"
const PLAYER_SHEET_FALLBACK := "res://julian assange sprite sheet.png"
const PLAYER_FRAME_RIGHT := 8
const PLAYER_SHEET_COLS := 4
const PLAYER_SHEET_ROWS := 4
const PLAYER_ZOOM := 2          ## integer only, or the pixels go soft

## Board-space geometry — MUST match gen_art.py exactly.
## A long, low room: 548x256 is nearly 2.2:1, drawn at 2x for a 1096x512 stage.
const BOARD_W := 548
const BOARD_H := 256
## The ceiling is SOLID. Overcook a high lob and it clatters off the beams.
const CEILING_Y := 14.0
const FLOOR_Y := 208.0
const LAUNCH_X := 54.0
const LAUNCH_Y := 176.0
const STAND_X := 50.0

## ONE square socket. Interior is exactly one icon square, so a clean hit fills
## it perfectly. It RELOCATES before every throw, which is the real difficulty:
## you cannot groove one shot and repeat it, you have to re-read the range each
## time and the anxiety wobble is fighting you while you do.
const SOCKET_OUTER := 15.0
const SOCKET_MOVES := true
## Where it is allowed to appear — the upper right of the room. Every position
## in here was checked reachable: best angles land between 19 and 25 degrees and
## the power window never drops below 0.65 of the meter. The bottom edge stops
## short of the mirror so the socket never sits on top of it.
const SOCKET_ROAM_X0 := 396.0
const SOCKET_ROAM_X1 := 528.0
const SOCKET_ROAM_Y0 := 18.0
const SOCKET_ROAM_Y1 := 66.0
## Never re-roll onto (nearly) the same spot — a "move" you cannot see is worse
## than not moving at all.
const SOCKET_MIN_MOVE := 34.0
## Where it starts, and where it stays if SOCKET_MOVES is off.
const SOCKET_HOME_X := 526.0
const SOCKET_HOME_Y := 20.0

## "Mostly fits and it connects": capture when the icon centre lands within
## this many board units of the socket centre, on either axis. 13 is generous
## on purpose — the icon is 13 wide and the socket 15, so this is roughly "any
## real contact counts". THIS IS THE DIFFICULTY KNOB. Tightening it toward 8
## makes the corner brutal at high anxiety; loosening it past 14 makes the
## throw forgiving enough that anxiety stops mattering.
const CAPTURE_HALF := 13.0

const SOCKET_CELL_W := 15
const SOCKET_CELL_H := 17
const DOT_CELL := 5
const PUFF_CELL := 26

const SCALE := 2.0            ## integer upscale so pixels stay crisp

## Ammo is drawn EXACTLY the way the anxiety bar draws it, chrome included:
## anxiety_bar.gd uses a ROW_ICON_PX (26) bordered square slot with the icon
## itself at ROW_ICON_PX - 6 inside it. Reusing the whole slot — not just the
## texture — is what makes every trait a uniform square, whatever shape the
## source art happens to be.
const SLOT_PX := 26          ## == anxiety_bar.gd ROW_ICON_PX
const ICON_PX := SLOT_PX - 6 ## == the TextureRect size inside that slot

# --------------------------------------------------------------- palette -----
const C_INK := Color("#1B1020")
const C_PLATE := Color("#42204A")
const C_MAROON := Color("#8C2E48")
const C_RUST := Color("#C87A55")
const C_RED := Color("#E36956")
const C_ORANGE := Color("#EFA660")
const C_ORANGE_LT := Color("#FFD07A")
const C_CREAM := Color("#FFFFEB")
const C_GOLD := Color("#FFE478")
const C_GREEN := Color("#3CA370")
const C_GREY := Color("#6E6A80")
const C_GREY_LT := Color("#C6C3D6")

# ------------------------------------------------------------- tuning --------
## Board units per second squared. Solved against the geometry above, not
## guessed. The speed range is deliberately NARROW — it brackets the two real
## solutions rather than spanning everything physically possible. That is the
## single biggest lever on fairness here: a wide range means one notch of the
## power meter is worth a huge jump in distance, and with holders this small
## the shot stops being readable. Bracketing it buys the precision back.
##
## Gravity, the bounce constants, the wobble tiers and the charge rates are all
## unchanged from the previous build — the throw feels identical. Only the
## speed bracket moved, and it had to: the socket is now ~480 units away in the
## far corner instead of ~250, which is simply out of range at the old speeds.
##
## The solution that falls out is flat and quick: ~23 degrees at roughly 29-66%
## power. Full power overshoots into the wall.
const GRAVITY := 500.0
const SPEED_MIN := 855.0
const SPEED_MAX := 1475.0
const ANGLE_MIN := 8.0
const ANGLE_MAX := 80.0
## Right on the corner socket's solution.
const ANGLE_START := 23.0

## Worst trait first: your biggest problem is the shot you take while the meter
## still feels unfamiliar.
const AMMO_ORDER_WORST_FIRST := true

## --- anxiety --------------------------------------------------------------
## Vertical aim wobble, in 25-point steps: 0-24, 25-49, 50-74, 75-99, 100.
## This is the headline difficulty knob and it is deliberately VISIBLE — the
## arrow drifts up and down in front of you and you throw into the gap.
## Degrees of amplitude per tier.
const WOBBLE_TIER_DEG := [0.0, 2.0, 4.0, 6.5, 9.5]
## Wobble speed also climbs, so high anxiety is fast AND wide.
const WOBBLE_TIER_HZ := [0.0, 0.85, 1.15, 1.45, 1.8]

## Aim nudge speed, calm -> maxed. Faster is worse: you overshoot the angle.
const AIM_SPEED := [30.0, 52.0]
## Charge meter travel, full sweeps 0->1 per second. Calm is a slow ~2.9s round
## trip you can place precisely; maxed out is 0.55s and basically a reflex test.
const CHARGE_RATE := [0.35, 1.80]
## Small residual error on launch speed. The wobble does the heavy lifting now.
const RELEASE_SPEED_ERR := [0.0, 0.06]

## Only the opening fifth of the arc is drawn. Enough to read the angle, not
## enough to solve the shot.
const TRACE_FRACTION := 0.20
const TRACE_DOTS := 6

## Strength arrow, board units.
const ARROW_MIN_LEN := 16.0
const ARROW_MAX_LEN := 74.0
const ARROW_SHAFT_HW := 2.5    ## half-width
const ARROW_HEAD_LEN := 13.0
const ARROW_HEAD_HW := 7.5

## Bounce response, 0..1 energy kept. A bounce off ANYTHING disqualifies the
## shot — the corner is not a backboard, and without this rule the right wall
## rebounds everything straight into the socket.
const BOUNCE_FLOOR := 0.42
const BOUNCE_WALL := 0.45
const BOUNCE_CEILING := 0.45
const FRICTION := 0.72
const SETTLE_SPEED := 30.0

const FLIGHT_STEP := 1.0 / 240.0
const FLIGHT_MAX_SEC := 9.0
const INPUT_GATE_FRAMES := 12

enum Phase { AIM, CHARGE, FLIGHT, SETTLE }

# ----------------------------------------------------------------- state -----
var _built := false
var _pixel_font: Font

var _tex_backdrop: Texture2D
var _tex_socket: Texture2D
var _tex_dot: Texture2D
var _tex_puff: Texture2D
var _tex_player: Texture2D

var _dim: ColorRect
var _outer: PanelContainer
var _title_label: Label
var _anx_label: Label
var _stage: Control
var _player_rect: TextureRect
var _socket_rect: TextureRect
var _socket_count_label: Label
## Top-left corner of the socket in board space. Moves every throw.
var _socket_pos := Vector2(SOCKET_HOME_X, SOCKET_HOME_Y)
var _projectile: PanelContainer
var _puff_rect: TextureRect
var _dots: Array = []
var _floor_icons: Array = []       ## missed traits left lying on the ground
var _arrow_edge: Polygon2D
var _arrow_fill: Polygon2D
var _queue_row: HBoxContainer
var _card_slot: PanelContainer
var _card_icon: TextureRect
var _card_name: Label
var _card_amount: Label
var _shots_label: Label
var _power_label: Label
var _hint_label: Label
var _call_label: Label
var _flash: ColorRect
var _summary: PanelContainer
var _summary_rows: VBoxContainer

var _traits: Array = []
var _anxiety := 25
var _diff := 0.0
var _tier := 1
var _index := 0
var _phase: int = Phase.AIM
var _angle := ANGLE_START
var _charge := 0.0
var _charge_dir := 1.0
var _wobble_t := 0.0
var _socket_count := 0
var _obscured: Array = []
var _exposed: Array = []
var _shots: Array = []
var _running := false
var _abort_requested := false
var _input_gate_frame := 0


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_STOP
	process_mode = Node.PROCESS_MODE_ALWAYS
	visible = false
	if ResourceLoader.exists("res://PressStart2P-Regular.ttf"):
		_pixel_font = load("res://PressStart2P-Regular.ttf")
	_load_art()
	_build_ui()


# ------------------------------------------------------------------ helpers --
func _load_tex(path: String) -> Texture2D:
	if path.is_empty():
		return null
	if ResourceLoader.exists(path):
		var t := load(path) as Texture2D
		if t != null:
			return t
	var img := Image.new()
	if img.load(path) == OK:
		return ImageTexture.create_from_image(img)
	push_warning("[TraitLob] missing art: %s" % path)
	return null


func _load_art() -> void:
	_tex_backdrop = _load_tex(BACKDROP_PNG)
	_tex_socket = _load_tex(SOCKET_PNG)
	_tex_dot = _load_tex(DOT_PNG)
	_tex_puff = _load_tex(PUFF_PNG)
	_tex_player = _load_tex(PLAYER_SHEET)
	if _tex_player == null:
		_tex_player = _load_tex(PLAYER_SHEET_FALLBACK)


func _atlas(tex: Texture2D, index: int, cell_w: int, cell_h: int) -> Texture2D:
	if tex == null:
		return null
	var a := AtlasTexture.new()
	a.atlas = tex
	a.region = Rect2(index * cell_w, 0, cell_w, cell_h)
	a.filter_clip = true
	return a


## Grid atlas, for the 4x4 player walk sheet.
func _atlas_grid(tex: Texture2D, frame: int, cols: int, rows: int) -> Texture2D:
	if tex == null:
		return null
	var cw: int = int(tex.get_width() / float(cols))
	var ch: int = int(tex.get_height() / float(rows))
	var a := AtlasTexture.new()
	a.atlas = tex
	a.region = Rect2((frame % cols) * cw, (frame / cols) * ch, cw, ch)
	a.filter_clip = true
	return a


func _pixel_rect(tex: Texture2D, w: float, h: float) -> TextureRect:
	var r := TextureRect.new()
	r.texture = tex
	r.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	r.stretch_mode = TextureRect.STRETCH_SCALE
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.custom_minimum_size = Vector2(w, h)
	r.size = Vector2(w, h)
	return r


func _style_label(lab: Label, size: int, color: Color) -> void:
	if _pixel_font:
		lab.add_theme_font_override("font", _pixel_font)
	lab.add_theme_font_size_override("font_size", size)
	lab.add_theme_color_override("font_color", color)
	lab.mouse_filter = Control.MOUSE_FILTER_IGNORE


func _panel_style(bg: Color, border: Color, width: int = 2, radius: int = 4,
		margin: int = 8) -> StyleBoxFlat:
	var st := StyleBoxFlat.new()
	st.bg_color = bg
	st.border_color = border
	st.set_border_width_all(width)
	st.set_corner_radius_all(radius)
	st.set_content_margin_all(margin)
	return st


## Board coordinates -> stage pixels.
func _px(v: float) -> float:
	return v * SCALE


func _pxv(v: Vector2) -> Vector2:
	return v * SCALE


func _place(node: Control, board_x: float, board_y: float) -> void:
	node.position = Vector2(_px(board_x), _px(board_y))


func _scaled(pair: Array) -> float:
	return lerpf(float(pair[0]), float(pair[1]), _diff)


func _socket_centre() -> Vector2:
	return _socket_pos + Vector2(SOCKET_OUTER, SOCKET_OUTER) * 0.5


## Checked only while the shot is still clean — a carom does not count as
## sticking it.
func _capture_hit(p: Vector2) -> bool:
	var c: Vector2 = _socket_centre()
	return absf(p.x - c.x) <= CAPTURE_HALF and absf(p.y - c.y) <= CAPTURE_HALF


## Drop the socket somewhere new in the roam box, far enough from where it was
## that the move actually reads.
func _relocate_socket() -> void:
	if not SOCKET_MOVES:
		return
	var prev: Vector2 = _socket_pos
	var next: Vector2 = prev
	for _attempt in range(24):
		next = Vector2(
			randf_range(SOCKET_ROAM_X0, SOCKET_ROAM_X1),
			randf_range(SOCKET_ROAM_Y0, SOCKET_ROAM_Y1))
		if next.distance_to(prev) >= SOCKET_MIN_MOVE:
			break
	_socket_pos = next
	if _socket_rect:
		_place(_socket_rect, _socket_pos.x, _socket_pos.y)


## The uniform ammo square. This is anxiety_bar.gd's hover-row slot rebuilt
## exactly: same 26px bordered panel, same 20px icon centred inside it, same
## red/green border rule. Reusing the chrome and not just the texture is what
## makes every trait the same shape no matter what the source art looks like.
func _make_icon_square(tex: Texture2D, amount: int, locked: bool,
		border_override = null) -> PanelContainer:
	var slot := PanelContainer.new()
	slot.custom_minimum_size = Vector2(SLOT_PX, SLOT_PX)
	slot.size = Vector2(SLOT_PX, SLOT_PX)
	slot.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var border: Color = C_GREEN if amount < 0 else C_RED
	if locked:
		border = Color(0.62, 0.10, 0.10, 1.0)
	if border_override != null:
		border = border_override
	var st := StyleBoxFlat.new()
	st.bg_color = Color(0.10, 0.07, 0.06, 0.96)
	st.border_color = border
	st.set_border_width_all(2)
	st.set_corner_radius_all(2)
	st.set_content_margin_all(2)
	slot.add_theme_stylebox_override("panel", st)

	# Always built, even with a null texture, so the card can swap it per shot.
	var ic := TextureRect.new()
	ic.name = "Icon"
	ic.texture = tex
	ic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	ic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	ic.custom_minimum_size = Vector2(ICON_PX, ICON_PX)
	ic.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	slot.add_child(ic)
	return slot


# ----------------------------------------------------------------- build -----
func _build_ui() -> void:
	if _built:
		return
	_built = true

	_dim = ColorRect.new()
	_dim.color = Color(0.02, 0.01, 0.04, 0.86)
	_dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_dim.mouse_filter = Control.MOUSE_FILTER_STOP
	add_child(_dim)

	var center := CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	center.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(center)

	_outer = PanelContainer.new()
	_outer.add_theme_stylebox_override("panel",
		_panel_style(C_PLATE, C_INK, 3, 8, 6))
	_outer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	center.add_child(_outer)

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 5)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_outer.add_child(col)

	col.add_child(_build_header())
	col.add_child(_build_stage())

	_build_summary()


func _build_header() -> Control:
	var bar := PanelContainer.new()
	bar.add_theme_stylebox_override("panel",
		_panel_style(Color(0.06, 0.04, 0.08, 0.95), C_GOLD, 2, 4, 6))
	bar.mouse_filter = Control.MOUSE_FILTER_IGNORE

	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 12)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	bar.add_child(row)

	_title_label = Label.new()
	_title_label.text = "THE DATE  —  ROUND 1:  HIDE IT"
	_style_label(_title_label, 12, C_GOLD)
	_title_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(_title_label)

	_socket_count_label = Label.new()
	_socket_count_label.text = ""
	_style_label(_socket_count_label, 10, C_GREEN)
	_socket_count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	row.add_child(_socket_count_label)

	_anx_label = Label.new()
	_anx_label.text = "ANXIETY 25"
	_style_label(_anx_label, 10, C_RED)
	_anx_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	row.add_child(_anx_label)

	return bar


func _build_stage() -> Control:
	var frame := PanelContainer.new()
	frame.add_theme_stylebox_override("panel",
		_panel_style(C_INK, C_MAROON, 2, 4, 2))
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE

	_stage = Control.new()
	_stage.custom_minimum_size = Vector2(_px(BOARD_W), _px(BOARD_H))
	_stage.clip_contents = true
	_stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.add_child(_stage)

	_stage.add_child(_pixel_rect(_tex_backdrop, _px(BOARD_W), _px(BOARD_H)))

	# --- the socket -------------------------------------------------------
	_socket_rect = _pixel_rect(_atlas(_tex_socket, 0, SOCKET_CELL_W, SOCKET_CELL_H),
		_px(SOCKET_CELL_W), _px(SOCKET_CELL_H))
	_place(_socket_rect, _socket_pos.x, _socket_pos.y)
	_stage.add_child(_socket_rect)

	# --- the thrower: real Player 2 sprite, right-facing idle --------------
	var pw := 0.0
	var ph := 0.0
	if _tex_player != null:
		pw = (_tex_player.get_width() / float(PLAYER_SHEET_COLS)) * float(PLAYER_ZOOM)
		ph = (_tex_player.get_height() / float(PLAYER_SHEET_ROWS)) * float(PLAYER_ZOOM)
	_player_rect = _pixel_rect(
		_atlas_grid(_tex_player, PLAYER_FRAME_RIGHT, PLAYER_SHEET_COLS, PLAYER_SHEET_ROWS),
		pw, ph)
	_player_rect.position = Vector2(_px(STAND_X) - pw * 0.5, _px(FLOOR_Y + 2.0) - ph)
	_stage.add_child(_player_rect)

	# --- trajectory trace (short) -----------------------------------------
	for i in range(TRACE_DOTS):
		var d := _pixel_rect(_atlas(_tex_dot, 0, DOT_CELL, DOT_CELL),
			_px(DOT_CELL), _px(DOT_CELL))
		d.visible = false
		_stage.add_child(d)
		_dots.append(d)

	# --- strength arrow (Node2D, so it can be an actual arrow) -------------
	_arrow_edge = Polygon2D.new()
	_arrow_edge.color = C_INK
	_stage.add_child(_arrow_edge)
	_arrow_fill = Polygon2D.new()
	_arrow_fill.color = C_GOLD
	_stage.add_child(_arrow_fill)
	_set_arrow_visible(false)

	# --- the trait in flight ----------------------------------------------
	# The thing in flight is the same square the anxiety bar shows, not a bare
	# texture — so what you throw looks like what you saw on the bar.
	_projectile = _make_icon_square(null, 1, false)
	_projectile.pivot_offset = Vector2(SLOT_PX, SLOT_PX) * 0.5
	_projectile.visible = false
	_stage.add_child(_projectile)

	_puff_rect = _pixel_rect(_atlas(_tex_puff, 0, PUFF_CELL, PUFF_CELL),
		_px(PUFF_CELL), _px(PUFF_CELL))
	_puff_rect.visible = false
	_stage.add_child(_puff_rect)

	_build_queue_overlay()
	_build_card_overlay()
	_build_hint_overlay()
	_build_call_overlay()

	_flash = ColorRect.new()
	_flash.color = Color(1, 1, 1, 0)
	_flash.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_flash.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_stage.add_child(_flash)

	return frame


